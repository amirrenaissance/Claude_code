# Trainual credentials for the setter-onboarding build scripts.
# Copy to .env and fill in. .env is git-ignored; never commit real values.
# The scripts read real environment variables first, then fall back to .env.

# API key: Trainual > Settings > Integrations > API (owner/admin only)
TRAINUAL_API_KEY=

# Account ID: the UUID in your Trainual web URLs (app.trainual.com/<account-id>/...)
TRAINUAL_ACCOUNT_ID=

# Only if the official API reference turns out to require basic auth instead of a key
# TRAINUAL_EMAIL=
# TRAINUAL_PASSWORD=
